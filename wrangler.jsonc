{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gmshop-edge",
	"main": "src/server-entry.ts",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"placement": { "mode": "smart" },
	"observability": { "enabled": true },
	"cache": { "enabled": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gmshop-edge",
			"migrations_dir": "drizzle","database_id": "7d6150cb-a1c9-4cc2-8870-72464216cc5c"
		}
	],
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "gmshop-edge-files","preview_bucket_name": "gmshop-edge-files" }],
	"send_email": [{ "name": "EMAIL" }],
	"kv_namespaces": [
		{ "binding": "CACHE","id": "4bacd87e061741cf98e71e22eb35deeb" }
	],
	"queues": {
		"producers": [
			{ "binding": "COMMERCE_QUEUE", "queue": "gmshop-edge-commerce" }
		],
		"consumers": [
			{
				"queue": "gmshop-edge-commerce",
				"max_batch_size": 10,
				"max_batch_timeout": 1,
				"max_concurrency": 4,
				"max_retries": 8,
				"retry_delay": 15,
				"dead_letter_queue": "gmshop-edge-commerce-dlq"
			}
		]
	},
	"triggers": { "crons": ["* * * * *"] }
}
